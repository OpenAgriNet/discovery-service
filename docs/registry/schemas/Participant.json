{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Participant",
  "type": "object",
  "required": ["Participant"],
  "properties": { "Participant": { "$ref": "#/definitions/Participant" } },

  "definitions": {

    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "name", "roles", "baseUrl", "status", "auth"],
      "properties": {
        "participantId": { "$ref": "#/definitions/ParticipantId" },
        "name":       { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "roles":      { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
                        "items": { "type": "string", "enum": ["provider", "consumer"] } },
        "baseUrl":    { "type": "string", "maxLength": 2000, "pattern": "^https?://(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9.:-]*(/[A-Za-z0-9._~%-]+)*$" },
        "status":     { "$ref": "#/definitions/Status" },
        "auth":       { "$ref": "#/definitions/Auth" },
        "publicKeys": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
                        "items": { "$ref": "#/definitions/PublicKey" } }
      },
      "allOf": [
        {
          "if": {
            "required": ["auth"],
            "properties": { "auth": { "required": ["scheme"],
                                      "properties": { "scheme": { "not": { "const": "none" } } } } }
          },
          "then": { "properties": { "baseUrl": { "pattern": "^https://(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9.:-]*(/[A-Za-z0-9._~%-]+)*$" } } }
        }
      ]
    },

    "Auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "scheme":      { "type": "string",
                         "enum": ["none", "apiKeyQuery", "apiKeyHeader", "basic"] },
        "paramName":   { "$ref": "#/definitions/ParamName" },
        "valuePrefix": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,30} $" },
        "paramNames":  { "type": "object", "minProperties": 1,
                         "additionalProperties": { "$ref": "#/definitions/ParamName" } },
        "secrets":     { "type": "object", "minProperties": 1,
                         "additionalProperties": { "$ref": "#/definitions/Secret" } }
      },
      "allOf": [
        { "if":   { "required": ["scheme"], "properties": { "scheme": { "const": "none" } } },
          "then": { "allOf": [ { "not": { "required": ["secrets"] } },
                               { "not": { "required": ["paramName"] } },
                               { "not": { "required": ["paramNames"] } },
                               { "not": { "required": ["valuePrefix"] } } ] } },
        { "if":   { "required": ["scheme"], "properties": { "scheme": { "enum": ["apiKeyQuery", "apiKeyHeader"] } } },
          "then": { "required": ["secrets"],
                    "oneOf": [
                      { "required": ["paramName"],
                        "not": { "required": ["paramNames"] },
                        "properties": { "secrets": { "maxProperties": 1 } } },
                      { "required": ["paramNames"],
                        "allOf": [ { "not": { "required": ["paramName"] } },
                                   { "not": { "required": ["valuePrefix"] } } ] } ] } },
        { "if":   { "required": ["scheme"], "properties": { "scheme": { "const": "apiKeyQuery" } } },
          "then": { "not": { "required": ["valuePrefix"] } } },
        { "if":   { "required": ["scheme"], "properties": { "scheme": { "const": "basic" } } },
          "then": { "required": ["secrets"],
                    "properties": { "secrets": { "required": ["username", "password"] } },
                    "allOf": [ { "not": { "required": ["paramName"] } },
                               { "not": { "required": ["paramNames"] } },
                               { "not": { "required": ["valuePrefix"] } } ] } }
      ]
    },

    "PublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "alg", "hash"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "alg":   { "type": "string", "enum": ["ed25519", "x25519"] },
        "hash":  { "$ref": "#/definitions/KeyHash" }
      }
    },

    "ParamName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "ParticipantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,63}$" },
    "Status": { "type": "string", "enum": ["active", "inactive"] },
    "MaterialRef": {
      "description": "A reference to security material held OUTSIDE the registry, as <scheme>:<locator>. Never the material itself. env:// resolved in the adapter's environment; inline: literal in the record; sha256: the fingerprint of a key delivered out of band. Narrowed per site by Secret and KeyHash — a new scheme is added here plus one allow-list.",
      "type": "string", "maxLength": 1024,
      "pattern": "^(env://[A-Z][A-Z0-9_]{0,63}|inline:[!-~][ -~]{0,998}|sha256:[a-f0-9]{64})$"
    },
    "Secret":  { "allOf": [ { "$ref": "#/definitions/MaterialRef" },
                            { "pattern": "^(env://|inline:)" } ] },
    "KeyHash": { "allOf": [ { "$ref": "#/definitions/MaterialRef" },
                            { "pattern": "^sha256:" } ] }
  },

  "_osConfig": {
    "uniqueIndexFields": ["participantId"],
    "indexFields":       ["status"],
    "privateFields":     ["$.auth.secrets"],
    "roles":             ["registryOperator"],
    "systemFields":      ["osCreatedAt", "osUpdatedAt", "osCreatedBy", "osUpdatedBy"]
  }
}
